# Required: API keys for the dashboard
API_KEYS="your-api-key-here"

# Security defaults
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS_PER_WINDOW="120"
ALLOW_PRIVATE_NETWORK_TARGETS="false"
# Optional CORS overrides (comma-separated, defaults to *)
# CORS_ALLOWED_ORIGINS="https://dashboard.example.com"
# CORS_ALLOWED_HEADERS="content-type,authorization,x-api-key,x-webhook-token"
# CORS_ALLOW_CREDENTIALS="false"
# CORS_MAX_AGE_SECONDS="86400"

# Required: Cloudflare bindings (configured in wrangler.jsonc)
# - AI binding (Workers AI) — auto-available when deployed, no credentials needed
# - BROWSER binding (Browser Rendering)
# - OUTPUT_BUCKET (R2)
# - SETTINGS_KV, TEMPLATES_KV (KV)

# ─── AI Providers ─────────────────────────────────────────────────────────────
#
# Mixed setup: Gemini for HTML/marketing, Workers AI for design tokens
#
# Google Gemini (HTML layout, marketing, classification)
GOOGLE_API_KEY="AIzaSy..."
# GOOGLE_MODEL="gemini-2.5-flash"
#
# Workers AI binding — auto-available when deployed as a Worker.
# For local dev (outside Worker), set REST API credentials:
# CLOUDFLARE_API_TOKEN="cfat_..."
# CLOUDFLARE_ACCOUNT_ID="your-account-id"
# LLM_MODEL="@cf/openai/gpt-oss-120b"

# ─── Optional ─────────────────────────────────────────────────────────────────

# Ghost CMS (only if using slug-based generation)
# GHOST_API_URL="https://YOUR_GHOST_DOMAIN/ghost/api/content"
# GHOST_CONTENT_API_KEY="YOUR_GHOST_CONTENT_API_KEY"

# Webhook security for /webhook/ghost
# GHOST_WEBHOOK_TOKEN="wh_..."
# GHOST_WEBHOOK_SECRET="whsec_..."

# Public URL for rendered assets
# R2_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"

# Notifications
# NOTIFY_WEBHOOK_URL="https://example.com/notify"

# UI deployment (set in ui/.env.production for static dashboard deploys)
# VITE_API_BASE="https://social-post-pipeline.YOUR_SUBDOMAIN.workers.dev"
# VITE_API_KEY="your-api-key-here"
