GHOST_API_URL="https://YOUR_GHOST_DOMAIN/ghost/api/content"
GHOST_CONTENT_API_KEY="YOUR_GHOST_CONTENT_API_KEY"
API_KEYS="replace-with-comma-separated-api-keys"
# Local template preview convenience: allow opening /template/* in browser without headers.
API_AUTH_REQUIRE_FOR_PREVIEW="false"

# Optional but recommended for public URLs in API responses.
R2_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"

# Webhook security for /webhook/ghost.
# Ghost-native mode: set GHOST_WEBHOOK_SECRET and configure the same value in Ghost webhook secret.
GHOST_WEBHOOK_SECRET="replace-with-ghost-webhook-secret"
# Legacy/manual mode: x-webhook-token must match this value.
GHOST_WEBHOOK_TOKEN="replace-with-random-secret"

# Optional callback after generation completes.
NOTIFY_WEBHOOK_URL="https://example.com/notify"
NOTIFY_HOST_ALLOWLIST="example.com,hooks.example.org"
IMAGE_HOST_ALLOWLIST=""
ALLOW_PRIVATE_NETWORK_TARGETS="false"

# Optional CORS overrides
CORS_ALLOWED_ORIGINS="*"
CORS_ALLOWED_HEADERS="content-type,authorization,x-api-key,x-webhook-token"
CORS_ALLOW_CREDENTIALS="false"
CORS_MAX_AGE_SECONDS="86400"
# Local stress/preview convenience: disable request throttling.
RATE_LIMIT_ENABLED="false"
# RATE_LIMIT_WINDOW_SECONDS="60"
# RATE_LIMIT_MAX_REQUESTS_PER_WINDOW="3000"

# Optional runtime overrides. If omitted, values from config/pipeline.config.yaml are used.
DEFAULT_BRAND_COLOR="#1f7a8c"
BRAND_NAME="Tasbir Blog"
LLM_MODEL="@cf/openai/gpt-oss-120b"
IMAGE_MODEL="@cf/black-forest-labs/flux-1-schnell"
R2_KEY_PREFIX="social-assets"
