# ─── REQUIRED ────────────────────────────────────────────────────────────
# Google AI Studio API key (free tier, unlimited Gemini 2.0 Flash)
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── OPTIONAL ────────────────────────────────────────────────────────────
# OpenRouter API key (fallback if Gemini rate limit hit)
OPENROUTER_API_KEY=

# Ghost CMS — auto-generate assets on post publish
# Admin key format: "id:secret" (Ghost Admin → Integrations)
GHOST_URL=
GHOST_ADMIN_API_KEY=
GHOST_WEBHOOK_SECRET=

# Penpot — design token management
PENPOT_URL=http://localhost:9001
PENPOT_ACCESS_TOKEN=

# Unsplash — free stock photo backgrounds
UNSPLASH_ACCESS_KEY=

# ─── DEFAULT VALUES (usually fine) ───────────────────────────────────────
# Database
DATABASE_URL=postgresql+asyncpg://tasbir:tasbir@localhost:5432/tasbir

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO S3-compatible storage
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=tasbir
MINIO_ROOT_PASSWORD=tasbir_secret
MINIO_BUCKET=tasbir-assets

# API security (comma-separated keys; leave empty to disable auth)
API_KEYS=

# Rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# CORS (comma-separated origins; * for all)
CORS_ORIGINS=*

# Logging
LOG_LEVEL=info

# Public API URL (used by SvelteKit UI)
PUBLIC_API_URL=http://localhost:8000

# Domain for Caddy reverse proxy (set for production)
DOMAIN=localhost
