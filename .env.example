# ─── REQUIRED ────────────────────────────────────────────────────────────
# Google AI Studio API key (free tier)
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── OPTIONAL ────────────────────────────────────────────────────────────
# OpenRouter API key (fallback if Gemini rate limit hit)
# Get at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ghost CMS — for auto-generation on post publish
# Admin API key format: "id:secret" (from Ghost Admin → Integrations)
GHOST_URL=
GHOST_ADMIN_API_KEY=
GHOST_WEBHOOK_SECRET=

# Penpot — for design token management
# Access token from Penpot user settings
PENPOT_URL=http://penpot:9001
PENPOT_ACCESS_TOKEN=

# Unsplash — for free stock photo backgrounds
# Get at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# ─── DEFAULT VALUES (usually fine) ───────────────────────────────────────
# MinIO S3-compatible storage
MINIO_ROOT_USER=tasbir
MINIO_ROOT_PASSWORD=tasbir_secret
MINIO_BUCKET=tasbir-assets

# Logging
LOG_LEVEL=info

# Public API URL (used by SvelteKit UI)
PUBLIC_API_URL=http://localhost:8000

# Domain for Caddy (set for production)
DOMAIN=localhost
