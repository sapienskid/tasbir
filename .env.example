# ─── REQUIRED ────────────────────────────────────────────────────────────
# Google AI Studio API key (free tier, Gemini 3.5 Flash Lite)
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional stock-photo provider keys (media tools). Wikimedia Commons needs none.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ─── API SECURITY ─────────────────────────────────────────────────────────
# Comma-separated API keys. REQUIRED — auth fails closed if empty.
API_KEYS=

# Rate limit per API key (requests/minute)
RATE_LIMIT_PER_MIN=30

# CORS origins (comma-separated; dev Vite server)
CORS_ORIGINS=http://localhost:5173

# ─── PLAYWRIGHT RENDER SERVICE ────────────────────────────────────────────
# Shared secret between the worker/api and the internal render service
RENDER_SERVICE_KEY=

# Internal render service URL (docker compose sets this; override only if
# you run the render service elsewhere)
RENDERER_URL=http://playwright:4000

# ─── IMAGE LOADING (SSRF guard) ───────────────────────────────────────────
# Comma-separated extra trusted hosts (skip the private-IP block for these)
IMAGE_ALLOW_HOSTS=
# Max image bytes and redirects
IMAGE_MAX_BYTES=10485760
IMAGE_MAX_REDIRECTS=2

# ─── RETENTION ────────────────────────────────────────────────────────────
# Generated files + task records older than this are swept (hours)
OUTPUT_TTL_HOURS=24

# Delete a file right after it is downloaded (?consume=true per request
# overrides). Default keeps files until the TTL sweep.
DELETE_ON_DOWNLOAD=false

# ─── OPTIONAL ─────────────────────────────────────────────────────────────
# OpenRouter API key (fallback if Gemini rate limit hit)
OPENROUTER_API_KEY=

# Skip the vision verifier (auto-pass) — dev only
SKIP_VERIFY=false

# ─── DEFAULT VALUES (usually fine) ───────────────────────────────────────
# SQLite database file
DATABASE_URL=sqlite+aiosqlite:///data/tasbir.db

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=info

# ─── GHCR IMAGE DEPLOY (docker-compose.yml) ──────────────────────────────
# Pin a published release tag (e.g. 1.0.0); leave empty for :latest
TASBIR_IMAGE_TAG=
# GHCR image owner (defaults to sapienskid); override when self-publishing
TASBIR_IMAGE_OWNER=
# UID:GID the api/worker/beat containers run as. Default 0:0 (root) so the
# tasbir_data volume is always writable regardless of who created it. If your
# host maps user 1000 and you pre-chown the volume, set TASBIR_USER=1000:1000.
TASBIR_USER=0:0
