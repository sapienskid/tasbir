# ─── REQUIRED ────────────────────────────────────────────────────────────
# Google AI Studio API key (free tier, Gemini 3.5 Flash Lite)
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional stock-photo provider keys (media tools). Wikimedia Commons needs none.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ─── API SECURITY ─────────────────────────────────────────────────────────
# Comma-separated API keys. REQUIRED — auth fails closed if empty.
API_KEYS=

# Rate limit per API key (requests/minute)
RATE_LIMIT_PER_MIN=30

# Separate per-key bucket for interactive editor traffic (previews, refill,
# editor state, compose previews) so editing never competes with generation.
RATE_LIMIT_INTERACTIVE_PER_MIN=600

# CORS origins (comma-separated; dev Vite server).
# On the VM via tunnel, set this to your public origin, e.g.
# CORS_ORIGINS=https://tasbir.example.com
CORS_ORIGINS=http://localhost:5173

# ─── PLAYWRIGHT RENDER SERVICE ────────────────────────────────────────────
# Shared secret between the worker/api and the internal render service
RENDER_SERVICE_KEY=

# ─── CLOUDFLARE TUNNEL (VM deploy, opt-in) ────────────────────────────────
# Token from Cloudflare dashboard → Zero Trust → Networks → Tunnels.
# Empty = tunnel service fails fast; only used with --profile tunnel.
CLOUDFLARED_TUNNEL_TOKEN=
# Bind for the api port. Default loopback-only (tunnel-only access).
# Set API_BIND=0.0.0.0:8000:8000 only to expose :8000 on the host LAN.
API_BIND=127.0.0.1:8000

# Internal render service URL (docker compose sets this; override only if
# you run the render service elsewhere)
RENDERER_URL=http://playwright:4000

# ─── IMAGE LOADING (SSRF guard) ───────────────────────────────────────────
# Comma-separated extra trusted hosts (skip the private-IP block for these)
IMAGE_ALLOW_HOSTS=
# Max image bytes and redirects
IMAGE_MAX_BYTES=10485760
IMAGE_MAX_REDIRECTS=2

# ─── RETENTION ────────────────────────────────────────────────────────────
# Generated files + task records older than this are swept (hours)
OUTPUT_TTL_HOURS=24

# Delete a file right after it is downloaded (?consume=true per request
# overrides). Default keeps files until the TTL sweep.
DELETE_ON_DOWNLOAD=false

# ─── OPTIONAL ─────────────────────────────────────────────────────────────
# (No generation fallback exists: 100% of LLM traffic goes through the
# Cloudflare AI Gateway below. GEMINI_API_KEY above is only ever sent as the
# Gateway's BYOK credential — nothing calls googleapis.com directly.)

# ─── CLOUDFLARE AI GATEWAY + DECISION MODELS ──────────────────────────────
# Single control plane for generation (Gateway) and judgments (Clef +
# Clef-flash on Workers AI, Neuron-billed — no Gateway credits needed).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_TOKEN=
CF_GATEWAY_ID=tasbir
# Decision provider order (primary → fallback). Vision packs force Clef.
DECISION_PROVIDER_ORDER=clef-flash,clef
# Calibration dual-run sample rate (0 disables; e.g. 0.1 = 10% second call).
DECISION_CALIBRATION_RATE=0.05
# Copy QA starts advisory-only; set true to block publish on low scores.
COPY_QA_ENFORCE=false

# Skip the vision verifier (auto-pass) — dev only
SKIP_VERIFY=false

# ─── DEFAULT VALUES (usually fine) ───────────────────────────────────────
# SQLite database file
DATABASE_URL=sqlite+aiosqlite:///data/tasbir.db

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=info

# ─── GHCR IMAGE DEPLOY (docker-compose.yml) ──────────────────────────────
# Pin a published release tag (e.g. 1.0.0); leave empty for :latest
TASBIR_IMAGE_TAG=
# GHCR image owner (defaults to sapienskid); override when self-publishing
TASBIR_IMAGE_OWNER=
# UID:GID the api/worker/beat containers run as. Default 0:0 (root) so the
# tasbir_data volume is always writable regardless of who created it. If your
# host maps user 1000 and you pre-chown the volume, set TASBIR_USER=1000:1000.
TASBIR_USER=0:0
