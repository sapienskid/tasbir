# ─── REQUIRED ────────────────────────────────────────────────────────────
# Google AI Studio API key (free tier, Gemini 2.0 Flash)
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── OPTIONAL ────────────────────────────────────────────────────────────
# OpenRouter API key (fallback if Gemini rate limit hit)
OPENROUTER_API_KEY=

# ─── API SECURITY ─────────────────────────────────────────────────────────
# Comma-separated API keys; leave empty to disable auth
API_KEYS=

# ─── DEFAULT VALUES (usually fine) ───────────────────────────────────────
# SQLite database file
DATABASE_URL=sqlite+aiosqlite:///data/tasbir.db

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated origins; * for all)
CORS_ORIGINS=*

# Logging
LOG_LEVEL=info
