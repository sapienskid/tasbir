FROM python:3.12-slim-bookworm

# Slim Playwright service: only the chromium HEADLESS SHELL is installed
# (no firefox/webkit/noVNC), cutting the image ~6x vs the official
# mcr.microsoft.com/playwright image. Sufficient for screenshot rendering.

# Browsers go here (persistent) so /root/.cache can be cleaned safely.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

COPY app/services/render_server.py /app/render_server.py

RUN pip install --no-cache-dir --disable-pip-version-check \
        playwright==1.61.0 \
        fastapi==0.139.2 \
        uvicorn==0.51.0 \
    && playwright install --with-deps --only-shell chromium \
    && rm -rf /var/lib/apt/lists/* \
    && pip cache purge

EXPOSE 4000

CMD ["uvicorn", "render_server:app", "--host", "0.0.0.0", "--port", "4000"]
