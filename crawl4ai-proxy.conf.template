# nginx proxy for crawl4ai — injects the CRAWL4AI_API_TOKEN header and proxies
# to the crawl4ai backend. Rendered by envsubst in the crawl4ai-proxy service.
server {
    listen 11235;

    location / {
        proxy_pass http://crawl4ai:11235;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Authorization "Bearer ${CRAWL4AI_API_TOKEN}";
        proxy_read_timeout 300s;
    }
}
