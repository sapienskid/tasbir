    "concurrently": "^9.2.1",
    "typescript": "~5.6.3",
    "vite": "^7.2.0",
    "vite-plugin-singlefile": "^2.2.1"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
