{
  "name": "social-post-pipeline-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev --local --live-reload --ip 127.0.0.1 --port 8787",
    "dev:ui": "pnpm run --dir ui dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "pnpm run --dir ui build",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^25.5.0",
    "typescript": "latest",
    "vitest": "^3.2.4",
    "wrangler": "latest"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.58",
    "@ai-sdk/openai": "^3.0.50",
    "@cloudflare/puppeteer": "1.0.6",
    "agents": "^0.7.5",
    "ai": "^6.0.146",
    "hono": "^4.12.10",
    "puppeteer": "^24.40.0",
    "workers-ai-provider": "^3.1.9",
    "zod": "^4.3.6"
  }
}
