{
  "name": "social-post-pipeline-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev --local --live-reload --ip 127.0.0.1 --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run typecheck && vitest run --passWithNoTests",
    "dashboard": "pnpm run --dir ui dev",
    "build:ui": "pnpm run --dir ui build",
    "ui:build": "pnpm run --dir ui build",
    "ui:lint": "pnpm run --dir ui lint",
    "validate": "pnpm run test && pnpm run ui:build && pnpm run ui:lint",
    "dev:server": "wrangler dev --env dev --local --ip 127.0.0.1 --port 8787",
    "dev:all": "concurrently --kill-others-on-fail --names \"server,ui\" \"pnpm run dev:server\" \"pnpm run dashboard\"",
    "deploy:staging": "pnpm run build:ui && wrangler deploy --env staging",
    "deploy:production": "pnpm run build:ui && wrangler deploy --env production",
    "deploy": "pnpm run deploy:production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "typescript": "latest",
    "vitest": "^3.2.4",
    "wrangler": "latest"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.58",
    "@ai-sdk/openai": "^3.0.50",
    "@cloudflare/puppeteer": "1.0.6",
    "agents": "^0.7.5",
    "ai": "^6.0.146",
    "hono": "^4.12.10",
    "puppeteer": "^24.40.0",
    "workers-ai-provider": "^3.1.9",
    "zod": "^4.3.6"
  }
}
