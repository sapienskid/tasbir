{
  "name": "social-post-pipeline-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm exec concurrently --kill-others-on-fail --names \"assets,worker\" --prefix-colors \"yellow,cyan\" \"pnpm exec chokidar \\\"templates/**/*.html\\\" \\\"src/styles/**/*.css\\\" \\\"config/pipeline/**/*.yaml\\\" \\\"scripts/embed-template-assets.mjs\\\" -c \\\"pnpm run build\\\" --debounce 250\" \"pnpm exec wrangler dev --local --live-reload --ip 127.0.0.1 --port 8787 --var API_AUTH_REQUIRE_FOR_PREVIEW:false\"",
    "build": "pnpm exec tailwindcss -i ./src/styles/template.css -o ./src/generated/template.css && node ./scripts/embed-template-assets.mjs",
    "render:all": "node ./scripts/render-template-variations.mjs",
    "render:stress": "node ./scripts/stress-render-suite.mjs",
    "test": "tsc --noEmit && vitest run",
    "deploy": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/cli": "^4.1.0",
    "@types/markdown-it": "^14.1.2",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.0",
    "typescript": "latest",
    "vitest": "^3.2.4",
    "wrangler": "latest",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.0.6",
    "agents": "^0.7.5",
    "katex": "^0.16.35",
    "markdown-it": "^14.1.1",
    "mermaid": "^11.12.3"
  }
}
