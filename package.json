{
  "name": "social-post-pipeline-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --live-reload --ip 127.0.0.1 --port 8787",
    "test": "tsc --noEmit && vitest run",
    "dashboard": "pnpm run --dir ui dev",
    "dev:server": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "dev:all": "concurrently --kill-others-on-fail --names \"server,ui\" \"pnpm run dev:server\" \"pnpm run dashboard\"",
    "deploy": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "puppeteer-core": "^24.38.0",
    "tsx": "^4.21.0",
    "typescript": "latest",
    "vitest": "^3.2.4",
    "wrangler": "latest",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.0.6",
    "@google/generative-ai": "^0.24.1",
    "agents": "^0.7.5",
    "hono": "^4.12.10",
    "puppeteer": "^24.40.0"
  }
}
