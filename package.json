{
  "name": "social-post-pipeline-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --live-reload --ip 127.0.0.1 --port 8787",
    "dev:ui": "pnpm run --dir ui dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "pnpm --dir ui install && pnpm run --dir ui build",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^25.5.0",
    "typescript": "5.6.3",
    "vitest": "^3.2.4",
    "wrangler": "latest"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.58",
    "@cloudflare/puppeteer": "1.0.6",
    "agents": "^0.7.5",
    "ai": "^6.0.146",
    "hono": "^4.12.10",
    "zod": "^4.3.6"
  }
}
