{
  "name": "social-post-pipeline-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "build:styles": "echo 'No separate style build needed. template.css is embedded by build:templates.'",
    "build:templates": "node ./scripts/embed-template-assets.mjs",
    "build:assets": "pnpm run build:templates",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "vitest": "^3.2.4",
    "wrangler": "latest",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.0.6"
  }
}
