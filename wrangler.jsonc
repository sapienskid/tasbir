{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "social-post-pipeline",
	"main": "src/index.ts",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"compatibility_date": "2026-03-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"API_AUTH_REQUIRE_FOR_PREVIEW": "true"
	},
	"ai": {
		"binding": "AI"
	},
	"browser": {
		"binding": "BROWSER"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "MARKETING_ORCHESTRATOR",
				"class_name": "MarketingOrchestratorAgent"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MarketingOrchestratorAgent"
			]
		}
	],
	"r2_buckets": [
		{
			"binding": "OUTPUT_BUCKET",
			"bucket_name": "social-post-assets"
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	"env": {
		"staging": {
			"name": "social-post-pipeline-staging",
			"ai": {
				"binding": "AI"
			},
			"browser": {
				"binding": "BROWSER"
			},
			"vars": {
				"API_AUTH_REQUIRE_FOR_PREVIEW": "true"
			},
			"r2_buckets": [
				{
					"binding": "OUTPUT_BUCKET",
					"bucket_name": "social-post-assets"
				}
			]
		},
		"production": {
			"name": "social-post-pipeline",
			"ai": {
				"binding": "AI"
			},
			"browser": {
				"binding": "BROWSER"
			},
			"vars": {
				"API_AUTH_REQUIRE_FOR_PREVIEW": "true"
			},
			"r2_buckets": [
				{
					"binding": "OUTPUT_BUCKET",
					"bucket_name": "social-post-assets"
				}
			]
		}
	}
}
