{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "social-post-pipeline",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"API_AUTH_REQUIRE_FOR_PREVIEW": "true"
	},
	"ai": {
		"binding": "AI"
	},
	"browser": {
		"binding": "BROWSER"
	},
	"kv_namespaces": [
		{
			"binding": "SETTINGS_KV",
			"id": "settings-kv-dev",
			"preview_id": "settings-kv-dev"
		},
		{
			"binding": "TEMPLATES_KV",
			"id": "templates-kv-dev",
			"preview_id": "templates-kv-dev"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "MARKETING_ORCHESTRATOR",
				"class_name": "MarketingOrchestratorAgent"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MarketingOrchestratorAgent"
			]
		}
	],
	"r2_buckets": [
		{
			"binding": "OUTPUT_BUCKET",
			"bucket_name": "social-post-assets"
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	"env": {
		"staging": {
			"name": "social-post-pipeline-staging",
			"ai": {
				"binding": "AI"
			},
			"browser": {
				"binding": "BROWSER"
			},
			"kv_namespaces": [
				{
					"binding": "SETTINGS_KV",
					"id": "settings-kv-staging"
				},
				{
					"binding": "TEMPLATES_KV",
					"id": "templates-kv-staging"
				}
			],
			"vars": {
				"API_AUTH_REQUIRE_FOR_PREVIEW": "true"
			},
			"r2_buckets": [
				{
					"binding": "OUTPUT_BUCKET",
					"bucket_name": "social-post-assets"
				}
			]
		},
		"production": {
			"name": "social-post-pipeline",
			"ai": {
				"binding": "AI"
			},
			"browser": {
				"binding": "BROWSER"
			},
			"kv_namespaces": [
				{
					"binding": "SETTINGS_KV",
					"id": "settings-kv-prod"
				},
				{
					"binding": "TEMPLATES_KV",
					"id": "templates-kv-prod"
				}
			],
			"vars": {
				"API_AUTH_REQUIRE_FOR_PREVIEW": "true"
			},
			"r2_buckets": [
				{
					"binding": "OUTPUT_BUCKET",
					"bucket_name": "social-post-assets"
				}
			]
		}
	}
}
