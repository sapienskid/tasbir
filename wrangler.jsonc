{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tasbir",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"build": {
		"command": "pnpm run build"
	},
	"assets": {
		"directory": "./ui/dist",
		"binding": "ASSETS"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	"ai": {
		"binding": "AI",
		"gateway": {
			"id": "tasbir"
		}
	},
	"browser": {
		"binding": "BROWSER"
	},
	"kv_namespaces": [
		{
			"binding": "SETTINGS_KV",
			"id": "524a3bbf4d5f43cd821d08593d24cf83"
		},
		{
			"binding": "TEMPLATES_KV",
			"id": "16d13f95d3004cd4931f6b07e016bf6f"
		}
	],
	"vars": {
		"API_AUTH_REQUIRE_FOR_PREVIEW": "true",
		"RATE_LIMIT_ENABLED": "true",
		"RATE_LIMIT_WINDOW_SECONDS": "60",
		"RATE_LIMIT_MAX_REQUESTS_PER_WINDOW": "120",
		"ALLOW_PRIVATE_NETWORK_TARGETS": "false"
	},
	"r2_buckets": [
		{
			"binding": "OUTPUT_BUCKET",
			"bucket_name": "social-post-assets"
		}
	]
}
